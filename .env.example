OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model (OpenRouter id). Prefer a mid-tier model for iteration.
DEVMEMORY_MODEL=openai/gpt-4.1-mini

