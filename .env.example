# OpenRouter (required for live extraction)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model (OpenRouter id). Dogfood default: Opus 5. Fast iteration: gpt-4.1-mini.
DEVMEMORY_MODEL=anthropic/claude-opus-5

# Optional: path to a sibling .env that already has OPENROUTER_API_KEY
# DEVMEMORY_ENV_FILE=/Users/you/Documents/experiments/pr-review-agent/.env
